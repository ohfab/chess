# Copy to .env.local for development, or set as repository variables for the
# GitHub Pages build (Settings → Secrets and variables → Actions → Variables).
# Without the two Supabase values Rookly runs fully local: no accounts, everything free.

# Supabase project (Project Settings → API). The anon key is public by design;
# row level security in supabase/migrations keeps every user to their own rows.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# where the app lives once published, and the contact address on the legal pages
VITE_APP_URL=https://rookly.app/
VITE_SUPPORT_EMAIL=hallo@rookly.app

# daily reminder push (optional): the public half of the VAPID key pair, see PUBLISHING.md
VITE_VAPID_PUBLIC_KEY=BE...

# the AI coach (daily plan, questions about a position): off until it launches; `on` turns it on
VITE_AI=

# Rookly Pro (subscription via Stripe): off at launch, everything free; `on` offers it
VITE_PRO=
