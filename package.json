{
  "name": "enpixant",
  "description": "Enpixant: Schach-Training mit Stockfish, Eröffnungstrainer, Taktik und Partie-Auswertung.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "openings": "node scripts/build-openings.mjs",
    "repertoire": "node --max-old-space-size=6000 scripts/build-repertoire.ts",
    "artifact": "NO_PWA=1 npm run build && node scripts/artifact-page.mjs",
    "i18n": "node scripts/i18n-check.mjs",
    "app": "NO_PWA=1 npm run build && cap sync",
    "app:android": "npm run app && cap open android",
    "app:ios": "npm run app && cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@lichess-org/chessground": "~10.4.2",
    "@supabase/supabase-js": "^2.118.0",
    "chess.js": "^1.4.0",
    "lucide-react": "~1.55.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "stockfish": "^19.0.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@resvg/resvg-js": "^2.6.2",
    "@twemoji/svg": "^15.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "opentype.js": "^2.0.0",
    "oxlint": "^1.89.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0"
  }
}
