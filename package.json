{
  "name": "knightly",
  "description": "Knightly: persönliches Schach-Training mit Stockfish und Eröffnungstrainer.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "openings": "node scripts/build-openings.mjs",
    "repertoire": "node --max-old-space-size=6000 scripts/build-repertoire.ts",
    "artifact": "npm run build && node scripts/artifact-page.mjs"
  },
  "dependencies": {
    "@lichess-org/chessground": "~10.4.2",
    "chess.js": "^1.4.0",
    "lucide-react": "~1.55.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "stockfish": "^19.0.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.5"
  }
}
